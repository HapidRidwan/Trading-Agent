# =======================================================
# TRADING AGENT - ENVIRONMENT VARIABLES
# =======================================================

# 1. Google Gemini AI API Key (Dapatkan di https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Default Gemini Model (Fallback stabil)
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# 3. Multi-Provider Real-Time Market Data (Auto-Failover berurutan)
# Prioritas 1: Twelve Data API Key (Opsional, https://twelvedata.com/)
TWELVEDATA_API_KEY=

# Prioritas 2: Yahoo Finance Chart API (100% Otomatis & Gratis Tanpa API Key untuk Forex, Gold & Crypto)

# Prioritas 3: FCS API Key (Cadangan Forex & Crypto API - gratis di https://fcsapi.com/)
FCSAPI_KEY=

# 4. PIN Keamanan 6 Digit untuk Kunci Layar Aplikasi (Melindungi kuota API pribadi)
APP_ACCESS_PIN=123456
